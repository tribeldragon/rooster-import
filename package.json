{
  "name": "rooster-import",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs",
    "test:parser": "node --experimental-strip-types scripts/test-parser.ts",
    "test:config": "node --experimental-strip-types scripts/test-config.ts",
    "test": "npm run test:parser && npm run test:config"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "tesseract.js": false
  }
}
